                              value.trim().isEmpty) {
                            return 'Date of Birth is required';
                          }
                          return null;
                        },
                      ),

                      const SizedBox(height: 16),

                      DropdownButtonFormField<String>(
                        initialValue: _selectedGender,
                        decoration: const InputDecoration(
                          labelText: 'Gender',
                          border: OutlineInputBorder(),
                        ),
                        items: const [
                          DropdownMenuItem(
                            value: 'Male',
                            child: Text('Male'),
                          ),
                          DropdownMenuItem(
                            value: 'Female',
                            child: Text('Female'),
                          ),
                          DropdownMenuItem(
                            value: 'Other',
                            child: Text('Other'),
                          ),
                        ],
                        onChanged: (value) {
                          setState(() {
                            _selectedGender = value;
                          });
                        },
                        validator: (value) {
                          if (value == null || value.isEmpty) {
                            return 'Gender is required';
                          }
                          return null;
                        },
                      ),

                      const SizedBox(height: 16),

                      _textField(
                        _addressController,
                        'Residential Address',
                        maxLines: 2,
                      ),
                      _textField(
                        _cityController,
                        'City / District',
                      ),
                      _textField(
                        _countryController,
                        'Country',
                      ),

                      _sectionTitle(
                        '4. Education',
                        'Provide details of your highest qualification.',
                      ),

                      _textField(
                        _schoolController,
                        'Institution / School',
                      ),
                      _textField(
                        _fieldOfStudyController,
                        'Field of Study',
                      ),
                      _textField(
                        _graduationYearController,
                        'Graduation Year',
                        keyboardType: TextInputType.number,
                      ),

                      _sectionTitle(
                        '5. Work Experience',
                        'Tell us about your relevant work experience.',
                      ),

                      _textField(
                        _experienceController,
                        'Work Experience',
                        required: false,
                        maxLines: 6,
                      ),

                      _sectionTitle(
                        '6. Required Documents',
                        'Documents will be stored securely and accessed '
                        'only by authorized recruitment staff.',
                      ),

                      _documentUploadCard(
                        'CV / Resume',
                        'Upload your current CV or resume.',
                        Icons.description_outlined,
                      ),
                      _documentUploadCard(
                        'Qualification Certificate',
                        'Certificate, Diploma, or Degree document.',
                        Icons.school_outlined,
                      ),
                      _documentUploadCard(
                        'National ID',
                        'Clear copy/photo of your National ID.',
                        Icons.badge_outlined,
                      ),
                      _documentUploadCard(
                        'Applicant Photo',
                        'Recent passport-style photo.',
                        Icons.photo_camera_outlined,
                      ),

                      _sectionTitle(
                        '7. Agreement & Consent',
                        'Please read and accept before submitting.',
                      ),

                      Card(
                        color: Theme.of(context)
                            .colorScheme
